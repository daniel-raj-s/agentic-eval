# ==============================================================================
# AI Agent Evaluation Pipeline Environment Configuration
# Copy this file to .env and fill in at least one provider key.
# ==============================================================================

# --- Judge / live-agent providers (at least ONE key for LLM metrics) ---

# Google Gemini (recommended free tier: https://aistudio.google.com/)
GEMINI_API_KEY=
# Optional alias accepted by Promptfoo's google provider.
# GOOGLE_API_KEY=

# Groq Cloud (fast free tier: https://console.groq.com/)
GROQ_API_KEY=

# OpenAI (optional / paid)
OPENAI_API_KEY=

# --- Evaluator / judge configuration ---
# Providers: gemini | groq | openai
EVAL_JUDGE_PROVIDER=gemini
EVAL_JUDGE_MODEL=gemini-3.8-flash
# Comma-separated models tried before the next provider in the chain.
EVAL_JUDGE_FALLBACKS=gemini-flash-lite-latest,gemini-3.6-flash,gemini-4-hydrogen
# Per-request judge timeout (seconds) and cooldown after a model fails.
EVAL_JUDGE_TIMEOUT=30
EVAL_JUDGE_COOLDOWN_SECONDS=30
# Throttle and retry policy for free-tier rate limits.
EVAL_JUDGE_MIN_INTERVAL_SECONDS=2
EVAL_JUDGE_RETRY_DELAY_SECONDS=6
EVAL_JUDGE_RETRY_BUDGET_SECONDS=120
# Set to 0 to disable trying other providers that happen to have a key.
EVAL_JUDGE_CROSS_PROVIDER=1

# --- Agent configuration ---
# deterministic = reproducible, free, no network (recommended for CI)
# llm           = live tool-calling loop through the selected provider
AGENT_MODE=deterministic
AGENT_PROVIDER=gemini
AGENT_MODEL=gemini-3.8-flash
# Availability-first fallback chain used only in llm mode.
AGENT_FALLBACKS=gemini-flash-lite-latest,gemini-3.6-flash
AGENT_TIMEOUT=45
AGENT_MAX_STEPS=6
AGENT_TEMPERATURE=0

# --- Telemetry (disabled by default) ---
DEEPEVAL_TELEMETRY_OPT_OUT=1
PROMPTFOO_DISABLE_TELEMETRY=1

# --- Quality gate policy ---
# Keep 0: missing LLM metrics must fail the gate. Set 1 only for a local run
# that intentionally has no judge credentials.
QUALITY_GATE_ALLOW_MISSING_JUDGE=0
# Set 1 when a red-team artifact is mandatory (e.g. scheduled security workflow).
QUALITY_GATE_REQUIRE_REDTEAM=0

# --- DeepEval Confident AI dashboard (optional) ---
CONFIDENT_AI_API_KEY=
